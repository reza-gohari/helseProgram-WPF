<!-- ///////////////// AZO ///////////////// -->

<Window x:Class="helseProgram.PasientInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pasientinformasjon"
        Height="600"
        Width="650"
        MinHeight="550"
        MinWidth="550"
        WindowStartupLocation="CenterOwner">

    <Grid Background="#F2F5F7">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="25">

                <TextBlock  Text="PasientInformasjon"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="#0C4F68"
                            Margin="0,0,0,20"/>

                <TextBlock  Text="Velg eksisterende pasient"
                            FontWeight="SemiBold"
                            Margin="0,0,0,5"/>

                <ComboBox   x:Name="PasientComboBox"
                            Height="32"
                            Margin="0,0,0,20"
                            DisplayMemberPath="FulltNavn"
                            SelectedValuePath="PasientId"
                            SelectionChanged="PasientComboBox_SelectionChanged"/>

                <TextBlock  Text="Fornavn"
                            FontWeight="SemiBold"
                            Margin="0,0,0,5"/>

                <TextBox    x:Name="FornavnTextBox"
                            Height="32"
                            Background="White"
                            BorderBrush="#A0A0A0"
                            BorderThickness="1"
                            Margin="0,0,0,15"/>

                <TextBlock  Text="Etternavn"
                            FontWeight="SemiBold"
                            Margin="0,0,0,5"/>

                <TextBox    x:Name="EtternavnTextBox"
                            Height="32"
                            Margin="0,0,0,15"/>

                <TextBlock  Text="Fødselsdato"
                            FontWeight="SemiBold"
                            Margin="0,0,0,5"/>

                <DatePicker x:Name="FodselsdatoPicker"
                            Height="32"
                            Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition   Width="*"/>
                        <ColumnDefinition   Width="20"/>
                        <ColumnDefinition   Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock  Text="Vekt (kg)"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,5"/>

                        <TextBox    x:Name="VektTextBox"
                                    Height="32"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock  Text="Høyde (cm)"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,5"/>

                        <TextBox    x:Name="HoydeTextBox"
                                    Height="32"/>
                    </StackPanel>
                </Grid>


                <TextBlock  Text="Journal"
                            FontWeight="SemiBold"
                            Margin="0,0,0,5"/>

                <TextBox    x:Name="JournalTextBox"
                            Height="120"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            VerticalScrollBarVisibility="Auto"
                            Margin="0,0,0,20"/>


                <!--Knapper-->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button x:Name="SlettPasientKnapp"
                            Content="Slett pasient"
                            Width="130"
                            Height="36"
                            Background="#C64242"
                            Foreground="White"
                            Margin="0,0,10,0"
                            IsEnabled="False"
                            Click="SlettPasientKnapp_Click"/>

                    <Button x:Name="LagrePasientKnapp"
                            Content="Lagre"
                            Width="130"
                            Height="36"
                            Background="#2E9D47"
                            Foreground="White"
                            Margin="0,0,10,0"
                            Click="LagrePasientKnapp_Click"/>

                    <Button Content="Avbryt"
                            Width="100"
                            Height="36"
                            Click="AvbrytKnapp_Click"/>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>