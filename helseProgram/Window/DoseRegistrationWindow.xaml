<Window x:Class="helseProgram.DoseRegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opprett dose"
        Width="760"
        Height="786"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,31" HorizontalAlignment="Center" Width="760">
        <StackPanel Margin="10">
            <GroupBox Header="Medikament" Margin="0,0,0,10">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Margin="0,0,0,3" Text="Forordningsmiddel" />
                        <ComboBox x:Name="MedicationComboBox"
                                  Height="27" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,3" Text="Doseform" />
                        <ComboBox x:Name="DoseFormComboBox"
                                  Height="27"
                                  SelectedIndex="0"
                                  SelectionChanged="DoseFormComboBox_SelectionChanged">
                            <ComboBoxItem Content="Velg..." />
                            <ComboBoxItem Content="Bolus" />
                            <ComboBoxItem Content="Infusjon" />
                            <ComboBoxItem Content="Injeksjon" />
                            <ComboBoxItem Content="Tablett" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Margin="0,0,0,3" Text="Administreringsmåte" />
                        <ComboBox x:Name="AdministrationRouteComboBox"
                                  Height="27"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Velg..." />
                            <ComboBoxItem Content="Intravenøst" />
                            <ComboBoxItem Content="Intramuskulært" />
                            <ComboBoxItem Content="Subkutant" />
                            <ComboBoxItem Content="Oralt" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="Administrering" Margin="0,0,0,10" Height="165">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Margin="0,0,0,3" Text="Dose" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="147*" />
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="113*"/>
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="82" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="DoseTextBox"
                 Grid.Column="0"
                 Height="27"
                 PreviewTextInput="DoseTextBox_PreviewTextInput"
                 PreviewKeyDown="DoseTextBox_PreviewKeyDown" Grid.ColumnSpan="3" />

                            <ComboBox x:Name="DoseUnitComboBox"
                  Grid.Column="4"
                  Height="27"
                  SelectedIndex="0">
                                <ComboBoxItem Content="mg" />
                                <ComboBoxItem Content="mcg" />
                                <ComboBoxItem Content="ml" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,3" Text="Lokalisasjon" />
                        <TextBox x:Name="LocationTextBox"
                                 Height="27" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Margin="0,15,0,0">
                        <TextBlock Margin="0,0,0,3" Text="Varighet" />

                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="KontinuerligCheckBox"
                                      Margin="0,5,18,0"
                                      Content="Kontinuerlig"
                                      IsEnabled="False"
                                      Checked="KontinuerligCheckBox_Endret"
                                      Unchecked="KontinuerligCheckBox_Endret" />

                            <ComboBox x:Name="VarighetTime"
                                      Width="60"
                                      Height="27"
                                      IsEnabled="False" />

                            <TextBlock Margin="6,5,12,0" Text="timer" />

                            <ComboBox x:Name="VarighetMinutt"
                                      Width="60"
                                      Height="27"
                                      IsEnabled="False" />

                            <TextBlock Margin="6,5,0,0" Text="minutter" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="Tidspunkt" Margin="0,0,0,10">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Margin="0,0,0,3" Text="Starttid" />
                        <TextBox x:Name="StartTimeTextBox"
                                 Height="27"
                                 MaxLength="5"
                                 ToolTip="Skriv klokkeslett i 24-timersformat, for eksempel 14:30" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,3" Text="Startdato" />
                        <DatePicker x:Name="StartDatePicker"
                                    Height="27"
                                    Width="140"
                                    HorizontalAlignment="Left"
                                    Language="nb-NO"
                                    SelectedDateFormat="Short" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="Tilleggsinformasjon" Margin="0,0,0,10">
                <StackPanel Margin="10">
                    <TextBlock Margin="0,0,0,3" Text="Kommentar" />
                    <TextBox x:Name="CommentTextBox"
                             Height="50"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </GroupBox>

            <DockPanel Margin="0,0,0,10" LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Width="120"
                        Height="28"
                        FontWeight="Bold"
                        Content="Opprett ny dose"
                        Click="CreateDoseButton_Click" />
            </DockPanel>

            <GroupBox Header="Registrerte doser" Margin="0,0,0,10">
                <DataGrid x:Name="RegisteredDosesGrid"
                          Height="122"
                          Margin="10,0,10,0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          Focusable="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Middel" Binding="{Binding Medication}" Width="125" />
                        <DataGridTextColumn Header="Mengde" Binding="{Binding Amount}" Width="60" />
                        <DataGridTextColumn Header="Dose" Binding="{Binding Dose}" Width="70" />
                        <DataGridTextColumn Header="Konsentrasjon" Binding="{Binding Concentration}" Width="90" />
                        <DataGridTextColumn Header="Administrasjon" Binding="{Binding Administration}" Width="105" />
                        <DataGridTextColumn Header="Varighet" Binding="{Binding Duration}" Width="80" />
                        <DataGridTextColumn Header="Starttid" Binding="{Binding StartTime}" Width="65" />
                        <DataGridTextColumn Header="Kommentar" Binding="{Binding Comment}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Width="95"
                        Height="28"
                        FontWeight="Bold"
                        Content="Lukk"
                        Click="CloseButton_Click" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
