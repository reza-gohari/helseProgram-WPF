<Window x:Class="helseProgram.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:simulering="clr-namespace:helseProgram.Simulering"
        mc:Ignorable="d"
        Title="Medikamentsimulering"
        Height="620"
        Width="1100"
        MinHeight="500"
        MinWidth="850">
    
    
    <!-- ///////////////// simen ///////////////// -->
    <!-- 
    Window Resources, for knapper, lager en egen sill som plaserers på kanppene i tool bar.
    her kan man endre farger, font, padding, margin, border og cursor og det vil endres for alle knappene i tool baren.
    HVORFOR: REDUNDANT KODE, for å unngå å skrive samme stil på alle knappene i tool baren.
    -->
    <Window.Resources>
        <Style x:Key="VerktoylinjeKnapp" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="BorderThickness" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Background="#F2F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" /> <!-- * gjør at raden tar resten av plassen som er tilgjengerlig på siden -->
        </Grid.RowDefinitions>

        <!-- Verktøylinje -->
        <Border Grid.Row="0"
                Background="#0C4F68"
                BorderBrush="#08394C"
                BorderThickness="0,0,0,1"
                Padding="8">
            
            
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="StartKnapp"
                            Content="▶  Start"
                            Background="#2E9D47"
                            Style="{StaticResource VerktoylinjeKnapp}"
                            Click="StartKnapp_Click" />

                    <Button x:Name="PauseKnapp"
                            Content="Ⅱ  Pause"
                            Background="#D28A16"
                            Style="{StaticResource VerktoylinjeKnapp}"
                            Click="PauseKnapp_Click" />

                    <Button x:Name="StoppKnapp"
                            Content="■  Stopp"
                            Background="#C64242"
                            Style="{StaticResource VerktoylinjeKnapp}"
                            Click="StoppKnapp_Click" />

                    <Separator Margin="12,0" />

                    <Button x:Name="OpprettDoseKnapp"
                            Content="＋  Opprett dose"
                            Background="#347B98"
                            Style="{StaticResource VerktoylinjeKnapp}" 
                            Click="OpprettDoseKnapp_Click" />

                </StackPanel>





                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="Simulasjonstid:"
                               Foreground="#D9E9EF"
                               FontSize="14"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="SimulasjonsTidText"
                               Text="00:00:00"
                               Foreground="White"
                               FontFamily="Consolas"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="8,0,20,0"
                               VerticalAlignment="Center" />
                    <Border Background="#163F50"
                            CornerRadius="4"
                            Padding="10,5">
                        <TextBlock x:Name="TilstandText"
                                   Text="Ikke startet"
                                   Foreground="White"
                                   FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Tidslinjen ligger i en egen kontroll -->
        <simulering:SimulasjonsTidslinje x:Name="Tidslinje"
                                            Grid.Row="1"
                                            Margin="10" />
    </Grid>
</Window>


